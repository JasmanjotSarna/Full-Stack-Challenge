# WindScope backend configuration (development defaults shown).
# Copy to backend/.env or export in your shell; never commit secrets.

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Elexon BMRS (public, no key required) ---------------------------------
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_CONNECT_TIMEOUT_SECONDS=10
ELEXON_READ_TIMEOUT_SECONDS=90
ELEXON_MAX_RETRIES=4
ELEXON_BACKOFF_BASE_SECONDS=1.5
ELEXON_MIN_REQUEST_INTERVAL_SECONDS=0.4
# Elexon caps date filters at 7 days; the client uses 6-day windows.
ELEXON_WINDOW_DAYS=6

# --- Data ------------------------------------------------------------------
# Leave blank to use <repo>/data/processed (local) or /app/data/processed (Docker).
DATA_DIR=
RAW_DATA_DIR=

# --- Decision cutoff (analytical assumption, not a market gate) ------------
# previous_day: latest WINDFOR published on/before CUTOFF_LOCAL_TIME on D-1.
# lead_hours:   latest WINDFOR published at least CUTOFF_LEAD_HOURS before delivery.
CUTOFF_MODE=previous_day
CUTOFF_LOCAL_TIME=00:00
CUTOFF_LEAD_HOURS=24
FORECAST_TIMEZONE=Europe/London

# --- Metric policy ---------------------------------------------------------
# MAPE excludes intervals whose actual generation is below this value.
MAPE_MIN_ACTUAL_MW=100

# --- Web / CORS ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- Optional protected refresh endpoint ----------------------------------
# Disabled by default. Refresh from the CLI for normal operation.
ALLOW_REFRESH_ENDPOINT=false
REFRESH_TOKEN=

# --- Test-data guard -------------------------------------------------------
# Must be true to serve a dataset labelled TEST DATA. Never set in production.
ALLOW_TEST_DATA=false
